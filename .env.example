# Variables de entorno de ejemplo para docker compose.
# Copia este archivo como .env (junto a docker-compose.yml) y cambia los valores.
DJANGO_SECRET_KEY=una-clave-larga-y-privada
ADMIN_EMAIL=ti@hotel.cl
ADMIN_PASSWORD=una-contraseña-segura
# Opcional: API key gratuita de la CMF (https://api.cmfchile.cl) para el dólar observado
CMF_API_KEY=
